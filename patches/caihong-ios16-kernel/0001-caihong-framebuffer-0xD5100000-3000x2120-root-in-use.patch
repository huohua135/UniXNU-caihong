+#define CAIHONG_FB_W 3000
+#define CAIHONG_FB_H 2120
+#define CAIHONG_FB_ROW 12000
+#define CAIHONG_OX ((CAIHONG_FB_W - HOUJI_LOGICAL_W) / 2)
+#define CAIHONG_OY ((CAIHONG_FB_H - HOUJI_LOGICAL_H) / 2)
 static uint64_t houji_fb_copy_bytes, houji_fb_present_ticks, houji_fb_max_present_ticks;
