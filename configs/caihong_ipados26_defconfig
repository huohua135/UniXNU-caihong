# Kernel configuration for caihong (OnePlus Pad Pro, SM8650) against the
# iPadOS 26.5.2 (23F84) profile — arch arm64e.
#
# Scope of this first 26-profile attempt: link a kernel that brings up the CPU
# platform (ARM device tree + ArmCpu) with nothing else. The board drivers that
# still need 26-profile inputs — mobile display, UFS/source storage, PMGR,
# pthread — stay off so one missing input cannot masquerade as another.
#
# Two switches are not free choices for this combination:
#   * CONFIG_XNU_SOURCE_CORECRYPTO14=y — build-xnu-4k-baseline.sh:171 refuses
#     the ArmCpu bring-up without the real source crypto provider.
#   * CONFIG_XNU_CRYPTO_BOOTSTRAP="source" — on xnu-12377 "prelinked" leaves
#     OSKext.cpp referring to source_corecrypto14_original/start_once while
#     prng_random.o no longer defines them (the vermeer board record on the same
#     profile reports the same). In source mode the bootstrap pass is expected
#     to report _corecrypto_kext_start before the archive exists: kernel.py
#     tolerates that pass while the compile records are written, and the build
#     force-loads libcorecrypto_kernel_noasm-namespaced.a into the final link.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_BUILD_ARCHIVES=y
# Run 43164890318 linked a kernel with chained fixups, and emit_prelink then
# stopped at fileset_layout.split_references: "Native image has no split-segment
# relocation information". The 12377 tree carries arm64e-threaded-starts.patch
# for exactly that combination; this profile's series does not apply it, so the
# linker never emits the records. Build the classic layout instead — the same
# path the 17.7.11 kernel took — and revisit chained fixups once the kext merge
# is the next problem rather than the first one.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=n
CONFIG_XNU_DT_PANIC_REGION=y

# caihong hardware platform
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Not yet: each of these needs an input this port does not have for 26.
CONFIG_XNU_SOURCE_PTHREAD=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_SOURCE_STORAGE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
